generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  USER
  ADMIN
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  image         String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  reviews      Review[]
  photos       Photo[]
  favorites    Favorite[]
  submissions             Attraction[]
  destinationSubmissions  Destination[] @relation("DestinationSubmissions")
  restaurantSubmissions   Restaurant[]  @relation("RestaurantSubmissions")
  accommodationSubmissions Accommodation[] @relation("AccommodationSubmissions")
  tripPlans        TripPlan[]
  poiFavorites     PoiFavorite[]
  journals         Journal[]
  journalLikes     JournalLike[]
  journalFavorites JournalFavorite[]
  journalComments  JournalComment[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refreshToken      String?
  accessToken       String?
  expiresAt         Int?
  tokenType         String?
  scope             String?
  idToken           String?
  sessionState      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Destination {
  id          String   @id @default(cuid())
  nameZh      String
  nameEn      String?
  province    String?
  description String?
  coverImage  String?
  latitude    Float?
  longitude   Float?
  country     String   @default("中国")
  isPublished Boolean  @default(true)
  status      SubmissionStatus @default(APPROVED)
  submittedById String?
  reviewNotes String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  attractions    Attraction[]
  restaurants    Restaurant[]
  accommodations Accommodation[]
  displayPhotos  Photo[]
  favorites      Favorite[]
  submittedBy    User?       @relation("DestinationSubmissions", fields: [submittedById], references: [id], onDelete: SetNull)

  @@map("destinations")
}

model Attraction {
  id            String           @id @default(cuid())
  destinationId String
  nameZh        String
  nameEn        String?
  description   String?
  address       String?
  latitude      Float?
  longitude     Float?
  ticketPrice   Float?
  openingHours  String?
  website       String?
  phone         String?
  isPublished   Boolean          @default(true)
  status        SubmissionStatus @default(APPROVED)
  submittedById String?
  reviewNotes   String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  submittedBy   User?       @relation(fields: [submittedById], references: [id], onDelete: SetNull)
  reviews       Review[]
  displayPhotos Photo[]
  favorites     Favorite[]

  @@map("attractions")
}

model Restaurant {
  id            String   @id @default(cuid())
  destinationId String
  nameZh        String
  nameEn        String?
  description   String?
  address       String?
  latitude      Float?
  longitude     Float?
  cuisineType   String?
  priceRange    String?
  openingHours  String?
  phone         String?
  website       String?
  isPublished   Boolean          @default(true)
  status        SubmissionStatus @default(APPROVED)
  submittedById String?
  reviewNotes   String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime @updatedAt

  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  submittedBy   User?       @relation("RestaurantSubmissions", fields: [submittedById], references: [id], onDelete: SetNull)
  reviews       Review[]
  displayPhotos Photo[]
  favorites     Favorite[]

  @@map("restaurants")
}

model Accommodation {
  id                String   @id @default(cuid())
  destinationId     String
  nameZh            String
  nameEn            String?
  description       String?
  address           String?
  latitude          Float?
  longitude         Float?
  accommodationType String?
  priceRange        String?
  starRating        Int?
  amenities         String?
  phone             String?
  website           String?
  status            SubmissionStatus @default(APPROVED)
  submittedById     String?
  reviewNotes       String?
  submittedBy       User? @relation("AccommodationSubmissions", fields: [submittedById], references: [id], onDelete: SetNull)
  isPublished       Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  reviews       Review[]
  displayPhotos Photo[]
  favorites     Favorite[]

  @@map("accommodations")
}

model Review {
  id              String   @id @default(cuid())
  userId          String
  attractionId    String?
  restaurantId    String?
  accommodationId String?
  rating          Int
  title           String?
  content         String
  visitDate       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  attraction    Attraction?   @relation(fields: [attractionId], references: [id], onDelete: Cascade)
  restaurant    Restaurant?   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  accommodation Accommodation? @relation(fields: [accommodationId], references: [id], onDelete: Cascade)
  photos        ReviewPhoto[]

  @@map("reviews")
}

model Photo {
  id              String   @id @default(cuid())
  url             String
  thumbnailUrl    String?
  altText         String?
  sortOrder       Int      @default(0)
  uploadedById    String?
  destinationId   String?
  attractionId    String?
  restaurantId    String?
  accommodationId String?
  createdAt       DateTime @default(now())

  destination    Destination?  @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  attraction     Attraction?   @relation(fields: [attractionId], references: [id], onDelete: Cascade)
  restaurant     Restaurant?   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  accommodation  Accommodation? @relation(fields: [accommodationId], references: [id], onDelete: Cascade)
  uploadedBy     User?         @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@map("photos")
}

model ReviewPhoto {
  id           String   @id @default(cuid())
  reviewId     String
  url          String
  thumbnailUrl String?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@map("review_photos")
}

model Favorite {
  id              String   @id @default(cuid())
  userId          String
  destinationId   String?
  attractionId    String?
  restaurantId    String?
  accommodationId String?
  createdAt       DateTime @default(now())

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination   Destination?  @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  attraction    Attraction?   @relation(fields: [attractionId], references: [id], onDelete: Cascade)
  restaurant    Restaurant?   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  accommodation Accommodation? @relation(fields: [accommodationId], references: [id], onDelete: Cascade)

  @@unique([userId, destinationId])
  @@unique([userId, attractionId])
  @@unique([userId, restaurantId])
  @@unique([userId, accommodationId])
  @@map("favorites")
}

model TripPlan {
  id          String   @id @default(cuid())
  userId      String
  title       String
  destination String?
  daysJson    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("trip_plans")
}

model Journal {
  id          String   @id @default(cuid())
  userId      String
  title       String
  content     String
  coverImage  String?
  region      String?
  likeCount   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  photos    JournalPhoto[]
  likes     JournalLike[]
  favorites JournalFavorite[]
  comments  JournalComment[]
  @@map("journals")
}

model JournalPhoto {
  id           String   @id @default(cuid())
  journalId    String
  url          String
  thumbnailUrl String?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  journal Journal @relation(fields: [journalId], references: [id], onDelete: Cascade)
  @@map("journal_photos")
}

model JournalLike {
  id        String   @id @default(cuid())
  userId    String
  journalId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  journal Journal @relation(fields: [journalId], references: [id], onDelete: Cascade)

  @@unique([userId, journalId])
  @@map("journal_likes")
}

model JournalFavorite {
  id        String   @id @default(cuid())
  userId    String
  journalId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  journal Journal @relation(fields: [journalId], references: [id], onDelete: Cascade)

  @@unique([userId, journalId])
  @@map("journal_favorites")
}

model JournalComment {
  id        String   @id @default(cuid())
  userId    String
  journalId String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  journal Journal @relation(fields: [journalId], references: [id], onDelete: Cascade)

  @@map("journal_comments")
}

model PoiFavorite {
  id        String   @id @default(cuid())
  userId    String
  poiId     String
  name      String
  address   String?
  lat       Float
  lng       Float
  type      String?
  icon      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, poiId])
  @@map("poi_favorites")
}
