DATABASE_URL="file:./dev.db"
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"
# 高德地图 API Key（Web 服务 + JS API）
AMAP_API_KEY="your-amap-web-key"
NEXT_PUBLIC_AMAP_JS_KEY="your-amap-js-key"
NEXT_PUBLIC_AMAP_JS_SECRET="your-amap-js-secret"
# Cloudflare R2（预留，本地存储尚未接入）
R2_ACCESS_KEY_ID="your-r2-key"
R2_SECRET_ACCESS_KEY="your-r2-secret"
R2_BUCKET_NAME="travel-photos"
R2_ENDPOINT="https://your-account.r2.cloudflarestorage.com"
# 飞猪 FlyAI 旅游顾问 (https://open.fly.ai/)
FLYAI_API_KEY="your-flyai-api-key"

# 正式部署建议使用随机 AUTH_SECRET；不要把示例值用于生产
AUTH_SECRET="replace-with-a-random-secret"
# 可选：独立持久图片目录；留空时使用 public/uploads
UPLOADS_DIR=""
